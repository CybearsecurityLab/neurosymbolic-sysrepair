  ;; Action: abort_on_remove
  ;; Source: apt-get
  ;; Reused from Phase 1
  (:action abort_on_remove
    :parameters (?pkg - package)
    :precondition (and
      (package_installed ?pkg)
    )
    :effect (and
      (abort_on_remove ?pkg)
    )
  )

  ;; Action: abort_pending_change
  ;; Source: snap
  ;; Reused from Phase 1
  (:action abort_pending_change
    :parameters (?change_type - file)
    :precondition (and
      (pending_change_exists ?change_type)
    )
    :effect (and
      (change_aborted ?change_type)
    )
  )

  ;; Action: accept_source_package_names
  ;; Source: apt-get
  ;; Reused from Phase 1
  (:action accept_source_package_names
    :parameters (?pkg - package)
    :precondition (and
      (package_exists ?pkg)
    )
    :effect (and
      (package_accepted_as_source ?pkg)
    )
  )

  ;; Action: acknowledge_warnings
  ;; Source: snap
  ;; Reused from Phase 1
  (:action acknowledge_warnings
    :parameters (?device - file)
    :precondition (and
      (device_exists ?device)
      (warnings_listed ?device)
    )
    :effect (and
      (warnings_acknowledged ?device)
    )
  )

  ;; Action: acquire_lock
  (:action acquire_lock
    :parameters (?l - firewall_rule)
    :precondition (and
      (not (lock_acquired ?l))
    )
    :effect (and
      (not (lock_acquired ?l))
      (lock_acquired ?l)
    )
  )

  ;; Action: activate_build_profiles
  ;; Source: apt-get
