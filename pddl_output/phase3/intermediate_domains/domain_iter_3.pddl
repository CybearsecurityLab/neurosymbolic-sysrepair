  ;; Action: userdel_with_group
  (:action userdel_with_group
    :parameters (?u - user ?g - group)
    :precondition (and
      (user_exists ?u)
      (group_exists ?g)
      (group_owned_by_user ?g ?u)
      (not (group_has_other_members ?g))
    )
    :effect (and
      (not (user_exists ?u))
      (not (group_exists ?g))
    )
  )

