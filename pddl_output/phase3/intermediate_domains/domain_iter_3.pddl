      (table_exists ?t)
      (chain_in_table ?c ?t)
      (executed_as_root ?p)
      (chain_exists ?c)
    )
    :effect (and
      (firewall_rule_in_chain ?r ?c)
      (rule_in_chain ?r ?c)
      (firewall_rule_exists ?r)
      (firewall_rule_active ?r)
    )
  )

