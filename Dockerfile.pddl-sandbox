FROM ubuntu:25.10

ENV DEBIAN_FRONTEND=noninteractive

# Install core tools + previously missing ones (nmcli, flatpak)
RUN apt-get update && apt-get install -y --no-install-recommends \
    systemd \
    sudo iproute2 iptables net-tools passwd adduser \
    coreutils snapd ufw nftables procps login kmod acl \
    network-manager flatpak \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Ensure /sbin and /usr/sbin are in PATH
ENV PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# Create test user for exploration walks
RUN useradd -m testuser

# Ensure essential directories exist
RUN mkdir -p /var/mail /var/spool/cron/crontabs

# --------------------------------------------------------------------------
# systemctl shim: wraps real systemctl with fallback for non-systemd PID 1.
# When systemctl fails because PID 1 isn't systemd, the shim handles common
# service operations (start/stop/enable/disable/status/restart) directly.
# --------------------------------------------------------------------------
RUN mv /usr/bin/systemctl /usr/bin/systemctl.real && \
    printf '#!/bin/bash\n\
# Try real systemctl first (suppress all output — shim provides its own)\n\
/usr/bin/systemctl.real "$@" >/dev/null 2>&1\n\
RC=$?\n\
[ $RC -eq 0 ] && { /usr/bin/systemctl.real "$@" 2>/dev/null; exit 0; }\n\
\n\
# Fallback: handle common operations without systemd as PID 1\n\
CMD="$1"; shift\n\
UNIT="${1%%.service}"\n\
\n\
STATE_DIR="/run/systemctl-shim"\n\
mkdir -p "$STATE_DIR"\n\
\n\
case "$CMD" in\n\
  start)\n\
    touch "$STATE_DIR/${UNIT}.active"\n\
    rm -f "$STATE_DIR/${UNIT}.failed"\n\
    echo "Started $UNIT (shim)" ;;\n\
  stop)\n\
    rm -f "$STATE_DIR/${UNIT}.active"\n\
    echo "Stopped $UNIT (shim)" ;;\n\
  restart|reload)\n\
    touch "$STATE_DIR/${UNIT}.active"\n\
    rm -f "$STATE_DIR/${UNIT}.failed"\n\
    echo "Restarted $UNIT (shim)" ;;\n\
  enable)\n\
    touch "$STATE_DIR/${UNIT}.enabled"\n\
    echo "Enabled $UNIT (shim)" ;;\n\
  disable)\n\
    rm -f "$STATE_DIR/${UNIT}.enabled"\n\
    echo "Disabled $UNIT (shim)" ;;\n\
  is-active)\n\
    [ -f "$STATE_DIR/${UNIT}.active" ] && echo "active" && exit 0\n\
    echo "inactive" && exit 3 ;;\n\
  is-enabled)\n\
    [ -f "$STATE_DIR/${UNIT}.enabled" ] && echo "enabled" && exit 0\n\
    echo "disabled" && exit 1 ;;\n\
  is-failed)\n\
    [ -f "$STATE_DIR/${UNIT}.failed" ] && echo "failed" && exit 0\n\
    echo "active" && exit 1 ;;\n\
  status)\n\
    if [ -f "$STATE_DIR/${UNIT}.active" ]; then\n\
      echo "● ${UNIT}.service - active (running)"\n\
    else\n\
      echo "● ${UNIT}.service - inactive (dead)"\n\
    fi ;;\n\
  is-system-running)\n\
    echo "running" ;;\n\
  cat|show|list-units|list-unit-files|daemon-reload|link)\n\
    exit 0 ;;\n\
  suspend|hibernate|reboot|poweroff|halt)\n\
    echo "Operation $CMD blocked in container" && exit 0 ;;\n\
  *)\n\
    exit 0 ;;\n\
esac\n' > /usr/bin/systemctl && chmod +x /usr/bin/systemctl

# Also shim hostnamectl, timedatectl, localectl which need dbus
RUN printf '#!/bin/bash\ncase "$1" in\n  status|"") echo "Static hostname: pddl-sandbox" ;;\n  set-hostname) echo "$2" > /etc/hostname ;;\n  *) exit 0 ;;\nesac\n' > /usr/bin/hostnamectl.shim && chmod +x /usr/bin/hostnamectl.shim && \
    [ ! -L /usr/bin/hostnamectl ] && mv /usr/bin/hostnamectl /usr/bin/hostnamectl.real 2>/dev/null; \
    ln -sf /usr/bin/hostnamectl.shim /usr/bin/hostnamectl || true

RUN printf '#!/bin/bash\ncase "$1" in\n  status|"") echo "Local time: $(date)"; echo "Time zone: UTC" ;;\n  set-timezone) echo "Timezone set to $2 (shim)" ;;\n  set-ntp) echo "NTP set to $2 (shim)" ;;\n  *) exit 0 ;;\nesac\n' > /usr/bin/timedatectl.shim && chmod +x /usr/bin/timedatectl.shim && \
    [ ! -L /usr/bin/timedatectl ] && mv /usr/bin/timedatectl /usr/bin/timedatectl.real 2>/dev/null; \
    ln -sf /usr/bin/timedatectl.shim /usr/bin/timedatectl || true

RUN printf '#!/bin/bash\ncase "$1" in\n  status|"") echo "System Locale: LANG=C.UTF-8" ;;\n  set-locale) echo "Locale set (shim)" ;;\n  set-keymap) echo "Keymap set (shim)" ;;\n  *) exit 0 ;;\nesac\n' > /usr/bin/localectl.shim && chmod +x /usr/bin/localectl.shim && \
    [ ! -L /usr/bin/localectl ] && mv /usr/bin/localectl /usr/bin/localectl.real 2>/dev/null; \
    ln -sf /usr/bin/localectl.shim /usr/bin/localectl || true

CMD ["sleep", "infinity"]
